+// NECN53WW exposes the eDP MUX and link-reset pin through LCD0. Read the
+// OEM pad identifiers so an unconfigured port or a changed route mode is
+// never mistaken for a display that needs its last state restored.
+static IOACPIPlatformDevice *loqLcdDevice()
+{
+    auto entry = IORegistryEntry::fromPath("IOACPIPlane:/_SB/PC00/PEG1@10000/PEGP@0/LCD0@8000a450");
+    auto lcd = OSDynamicCast(IOACPIPlatformDevice, entry);
+    UInt64 address = 0;
+    if (lcd && lcd->evaluateInteger("_ADR", &address) == kIOReturnSuccess &&
+        static_cast<UInt32>(address) == 0x8000a450)
+        return lcd;
+    OSSafeReleaseNULL(entry);
+    return nullptr;
+}
+
+static IOReturn loqPanelMethod(IOACPIPlatformDevice *lcd, const char *method,
+                               UInt32 argument, UInt32 *result)
+{
+    OSObject *parameter = OSNumber::withNumber(argument, 32);
+    if (!parameter)
+        return kIOReturnNoMemory;
+    IOReturn status = result ? lcd->evaluateInteger(method, result, &parameter, 1)
+                             : lcd->evaluateObject(method, nullptr, &parameter, 1);
+    parameter->release();
+    return status;
+}
+
+static bool loqDisplayPad(UInt32 pad)
+{
+    // Counts from this board's GPCS. Group 12 is virtual GPIO.
+    static constexpr UInt8 padsPerGroup[] = {25, 23, 12, 27, 8, 24, 8, 24, 17, 9, 16, 24, 0, 8, 23, 15, 24, 25};
+    const UInt32 group = (pad >> 16) & 0xff;
+    return pad != 0 && group < sizeof(padsPerGroup) && (pad & 0xffff) < padsPerGroup[group];
+}
+
+static LoqPanelState loqReadPanelState(IOACPIPlatformDevice *lcd)
+{
+    LoqPanelState state;
+    auto entry = IORegistryEntry::fromPath("IOACPIPlane:/_SB/PC00/PEG1@10000/PEGP@0");
+    if (auto gpu = OSDynamicCast(IOACPIPlatformDevice, entry)) {
+        if (gpu->evaluateInteger("DMMP", &state.muxPad) != kIOReturnSuccess)
+            state.muxPad = 0;
+        if (gpu->evaluateInteger("DLRP", &state.resetPad) != kIOReturnSuccess)
+            state.resetPad = 0;
+    }
+    OSSafeReleaseNULL(entry);
+    if (!loqDisplayPad(state.muxPad))
+        return {};
+
+    if (loqPanelMethod(lcd, "MXDM", 0, &state.mode) != kIOReturnSuccess ||
+        loqPanelMethod(lcd, "MXDS", 0, &state.route) != kIOReturnSuccess)
+        return {};
+
+    if (state.resetPad != state.muxPad && loqDisplayPad(state.resetPad)) {
+        if (loqPanelMethod(lcd, "LRST", 0, &state.reset) != kIOReturnSuccess || state.reset > 2)
+            state.reset = 0;
+    }
+    return state;
+}
+
+void NVRM::saveLoqPanelState()
+{
+    fLoqPanelState = {};
+    UInt32 enabled = 0;
+    if (!PE_parse_boot_argn("nvrmloqs3", &enabled, sizeof enabled) || enabled != 1 ||
+        fPCI->configRead32(0) != 0x28e110de || fPCI->configRead32(0x2c) != 0x3d0617aa)
+        return;
+
+    auto root = getPMRootDomain();
+    if (!root || root->getProperty("IOPMDeepIdleSupported") == kOSBooleanTrue)
+        return;
+
+    if (auto lcd = loqLcdDevice()) {
+        fLoqPanelState = loqReadPanelState(lcd);
+        lcd->release();
+    }
+    LOG("LOQ S3 eDP before sleep: mode %u route %u reset %u", fLoqPanelState.mode,
+        fLoqPanelState.route, fLoqPanelState.reset);
+}
+
+void NVRM::restoreLoqPanelState()
+{
+    const LoqPanelState saved = fLoqPanelState;
+    fLoqPanelState = {};
+    // MXDM 2 is discrete-only. MXDS 2 routes the panel to the NVIDIA GPU.
+    if (saved.mode != 2 || saved.route != 2)
+        return;
+
+    auto lcd = loqLcdDevice();
+    if (!lcd)
+        return;
+
+    LoqPanelState current = loqReadPanelState(lcd);
+    LOG("LOQ S3 eDP after wake: mode %u route %u reset %u", current.mode, current.route, current.reset);
+    if (current.mode == saved.mode && current.muxPad == saved.muxPad) {
+        if (current.route == 1) {
+            UInt32 restored = 0;
+            const IOReturn status = loqPanelMethod(lcd, "MXDS", 0x11, &restored);
+            current.route = 0;
+            if (status == kIOReturnSuccess)
+                loqPanelMethod(lcd, "MXDS", 0, &current.route);
+            LOG("LOQ S3 eDP discrete route restore: 0x%x, route %u", status, current.route);
+        }
+        // Preserve a previously released link. An asserted reset before
+        // system sleep can belong to the panel's ordinary power-down path.
+        if (current.route == 2 && saved.reset == 2 && current.reset == 1 &&
+            current.resetPad == saved.resetPad) {
+            const IOReturn status = loqPanelMethod(lcd, "LRST", saved.reset, nullptr);
+            UInt32 restored = 0;
+            if (status == kIOReturnSuccess)
+                loqPanelMethod(lcd, "LRST", 0, &restored);
+            LOG("LOQ S3 eDP link reset state restore: 0x%x, state %u", status, restored);
+        }
+    }
+    lcd->release();
+}
