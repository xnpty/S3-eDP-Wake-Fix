+#!/usr/bin/env python3
+"""Test that only a connected internal panel can reuse its validated EDID."""
+
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = (root / "kexts/NVRMFB/fb/nvrm-fb.cpp").read_text()
+start = source.index("static bool nvrmDefaultEdid(")
+end = source.index("void NVRMNVDAFramebuffer::hotplugFire(", start)
+fixture = r'''
+#include <cassert>
+#include <cstdint>
+#include <cstring>
+using NvU8 = uint8_t;
+using NvU16 = uint16_t;
+using NvU32 = uint32_t;
+constexpr bool NV_TRUE = true;
+struct nvrm_dpy_rec {
+    bool internal;
+    unsigned handle;
+    unsigned edidSize;
+    NvU8 edid[2048];
+};
+struct NvKmsKapiDynamicDisplayParams {
+    unsigned handle;
+    bool connected, overrideEdid, forceConnected;
+    struct { NvU16 bufferSize; NvU8 buffer[2048]; } edid;
+};
+static void nvu_zero(void *data, size_t size) { std::memset(data, 0, size); }
+static void nvu_copy(void *dst, const void *src, size_t size) { std::memcpy(dst, src, size); }
+'''
+checks = r'''
+int main() {
+    nvrm_dpy_rec panel{true, 0x800, 256, {0, 255, 255, 255, 255, 255, 255, 0, 0x06, 0xaf}};
+    panel.edid[126] = 1;
+    NvU8 sum = 0;
+    for (unsigned i = 0; i < 127; ++i) sum += panel.edid[i];
+    panel.edid[127] = -sum;
+
+    NvKmsKapiDynamicDisplayParams fallback{0x800, true, false, false, {128, {}}};
+    fallback.edid.buffer[8] = 0x3a;
+    fallback.edid.buffer[9] = 0xc4;
+    auto current = fallback;
+    assert(nvrmRestorePanelEdid(panel, &current));
+    assert(current.overrideEdid && !current.forceConnected && current.edid.bufferSize == 256);
+    assert(std::memcmp(current.edid.buffer, panel.edid, 256) == 0);
+    assert(!nvrmRestorePanelEdid(panel, &current));
+
+    current = fallback;
+    current.connected = false;
+    assert(!nvrmRestorePanelEdid(panel, &current) && !current.overrideEdid);
+    current = fallback;
+    current.handle = 0x100;
+    assert(!nvrmRestorePanelEdid(panel, &current));
+    current = fallback;
+    panel.internal = false;
+    assert(!nvrmRestorePanelEdid(panel, &current));
+    panel.internal = true;
+    panel.edid[255] = 1;
+    assert(!nvrmRestorePanelEdid(panel, &current));
+    panel.edid[255] = 0;
+    panel.edidSize = 128;
+    assert(!nvrmRestorePanelEdid(panel, &current));
+}
+'''
+with tempfile.TemporaryDirectory() as directory:
+    path = Path(directory)
+    (path / "test.cpp").write_text(fixture + source[start:end] + checks)
+    subprocess.run(["clang++", "-std=c++17", str(path / "test.cpp"), "-o", str(path / "test")], check=True)
+    subprocess.run([str(path / "test")], check=True)
+print("PASS: internal panel EDID fallback and validation")
