+static bool nvrmDefaultEdid(const NvU8 *bytes, NvU32 size)
+{
+    // NVIDIA's NVD:0000 fallback is a single EDID block.
+    return size == 128 && bytes[8] == 0x3a && bytes[9] == 0xc4 && !bytes[10] && !bytes[11];
+}
+
+static bool nvrmRestorePanelEdid(const struct nvrm_dpy_rec &saved,
+                               struct NvKmsKapiDynamicDisplayParams *current)
+{
+    static const NvU8 header[] = {0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00};
+    const NvU32 size = saved.edidSize;
+    if (!saved.internal || !current->connected || current->handle != saved.handle ||
+        !nvrmDefaultEdid(current->edid.buffer, current->edid.bufferSize) ||
+        size < 128 || size > sizeof saved.edid || size > sizeof current->edid.buffer || size % 128 ||
+        size / 128 != 1u + saved.edid[126] || memcmp(saved.edid, header, sizeof header) != 0 ||
+        nvrmDefaultEdid(saved.edid, size)) return false;
+    for (NvU32 block = 0; block < size; block += 128) {
+        NvU8 sum = 0;
+        for (NvU32 i = 0; i < 128; ++i) sum = (NvU8)(sum + saved.edid[block + i]);
+        if (sum) return false;
+    }
+    // Retain the physical panel's timings. NVKMS still determines whether the link is connected.
+    nvu_zero(current->edid.buffer, sizeof current->edid.buffer);
+    nvu_copy(current->edid.buffer, saved.edid, size);
+    current->edid.bufferSize = (NvU16)size;
+    current->overrideEdid = NV_TRUE;
+    return true;
+}
